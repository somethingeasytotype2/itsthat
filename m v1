function spawnMob(type,x,y,z){
 const stats={
  zombie:{hp:20,speed:1.8,damage:3,hostile:true},
  skeleton:{hp:20,speed:1.7,damage:3,hostile:true,ranged:true},
  creeper:{hp:20,speed:1.65,damage:20,hostile:true,explode:true},
  spider:{hp:16,speed:2.4,damage:2,hostile:true,jump:true},
  cow:{hp:10,speed:1.2,passive:true},
  pig:{hp:10,speed:1.25,passive:true},
  sheep:{hp:8,speed:1.1,passive:true}
 }[type];
 if(!stats)return;
 mobs.push({
  id:++mobId,type,x,y,z,vx:0,vy:0,vz:0,
  hp:stats.hp,maxHp:stats.hp,
  speed:stats.speed,damage:stats.damage,
  hostile:stats.hostile,passive:stats.passive,
  ranged:stats.ranged,explode:stats.explode,jump:stats.jump,
  path:[],pathIndex:0,pathTimer:0,
  attackTimer:0,wanderTimer:0,
  hurt:0
 });
}

function mobDistance(m,e=player){
 return Math.hypot(m.x-e.x,m.y-e.y,m.z-e.z);
}

function updateMob(m,dt){
 if(m.hp<=0)return;
 m.hurt=Math.max(0,m.hurt-dt);
 m.attackTimer=Math.max(0,m.attackTimer-dt);
 m.pathTimer-=dt;

 const dist=mobDistance(m);
 const night=Math.sin((time/dayLength)*Math.PI*2-Math.PI/2)<-.05;

 if(m.hostile&&dist<28&&night){
  if(m.pathTimer<=0){
   m.path=findPath(m,player,450);
   m.pathIndex=1;
   m.pathTimer=.7+Math.random()*.35;
  }
  if(m.path.length){
   const p=m.path[Math.min(m.pathIndex,m.path.length-1)];
   const dx=p.x+.5-m.x,dz=p.z+.5-m.z;
   const len=Math.hypot(dx,dz)||1;
   m.vx=dx/len*m.speed;
   m.vz=dz/len*m.speed;
   if(Math.hypot(dx,dz)<.35)m.pathIndex++;
  }
  if(dist<1.7){
   if(m.explode){
    if(m.attackTimer<=0){
     m.attackTimer=1;
     damagePlayer(8);
    }
   }else if(m.attackTimer<=0){
    m.attackTimer=1.1;
    damagePlayer(m.damage);
   }
  }
 }else{
  m.wanderTimer-=dt;
  if(m.wanderTimer<=0){
   m.wanderTimer=1+Math.random()*4;
   const a=Math.random()*Math.PI*2;
   m.vx=Math.cos(a)*m.speed*.35;
   m.vz=Math.sin(a)*m.speed*.35;
  }
 }

 m.vy-=22*dt;
 moveEntity(m,m.vx*dt,m.vy*dt,m.vz*dt,1.8,.3);
 if(m.onGround)m.vy=0;
 if(m.jump&&Math.random()<dt*.4)m.vy=7;

 if(m.passive&&dist<6&&Math.random()<dt*.7){
  const dx=m.x-player.x,dz=m.z-player.z,l=Math.hypot(dx,dz)||1;
  m.vx=dx/l*m.speed;m.vz=dz/l*m.speed;
 }
}

function damagePlayer(n){
 if(player.invuln>0)return;
 player.hp-=n;player.invuln=.7;
 if(player.hp<=0)die();
}
player.invuln=0;

function die(){
 player.hp=player.maxHp;
 player.x=player.spawn.x;player.y=player.spawn.y;player.z=player.spawn.z;
 player.vx=player.vy=player.vz=0;
 inv.forEach((s,i)=>{if(Math.random()<.7)inv[i]=null});
}

function spawnNatural(){
 if(mobs.length>45)return;
 const a=Math.random()*Math.PI*2;
 const d=18+Math.random()*32;
 const x=Math.floor(player.x+Math.cos(a)*d);
 const z=Math.floor(player.z+Math.sin(a)*d);
 const y=terrainHeight(x,z)+1;
 if(Math.abs(y-player.y)>15)return;
 const b=biomeAt(x,z);
 const night=Math.sin((time/dayLength)*Math.PI*2-Math.PI/2)<-.05;
 let type;
 if(night){
  const r=Math.random();
  type=r<.38?"zombie":r<.68?"skeleton":r<.88?"spider":"creeper";
 }else{
  type=b==="snow"?"sheep":Math.random()<.5?"cow":"pig";
 }
 spawnMob(type,x,y,z);
}

let spawnTimer=0;

function update(dt){
 if(paused||inventoryOpen||craftingOpen||furnaceOpen||chestOpen||sleeping)return;

 time+=dt;
 player.invuln=Math.max(0,player.invuln-dt);

 const speed=5.2;
 let mx=0,mz=0;
 if(keys.w) mz-=1;
 if(keys.s)mz+=1;
 if(keys.a)mx-=1;
 if(keys.d)mx+=1;
 const l=Math.hypot(mx,mz)||1;
 mx/=l;mz/=l;

 const ca=Math.cos(player.yaw),sa=Math.sin(player.yaw);
 const wx=mx*ca-mz*sa,wz=mx*sa+mz*ca;
 player.vx+=wx*speed*dt*8;
 player.vz+=wz*speed*dt*8;
 player.vx*=Math.pow(.0005,dt);
 player.vz*=Math.pow(.0005,dt);

 if(keys.space&&player.onGround)player.vy=8;
 player.vy-=22*dt;
 moveEntity(player,player.vx*dt,player.vy*dt,player.vz*dt,1.8,.3);

 if(player.onGround)player.vy=0;

 mine(dt);

 for(let i=mobs.length-1;i>=0;i--){
  updateMob(mobs[i],dt);
  if(mobs[i].hp<=0){
   const m=mobs[i];
   if(m.type==="cow")give("beef",1);
   if(m.type==="pig")give("pork",1);
   if(m.type==="sheep")give("wool",1);
   if(m.type==="skeleton")give("arrow",1);
   if(m.type==="spider")give("string",1);
   mobs.splice(i,1);
  }
 }

 spawnTimer-=dt;
 if(spawnTimer<=0){spawnTimer=2;spawnNatural();}
 saveTimer-=dt;
 if(saveTimer<=0){saveTimer=10;saveGame();}
}

function raycast(max=6){
 const ox=player.x,oy=player.y+1.62,oz=player.z;
 const dx=Math.cos(player.pitch)*Math.sin(player.yaw);
 const dy=Math.sin(player.pitch);
 const dz=Math.cos(player.pitch)*Math.cos(player.yaw);
 let px=Math.floor(ox),py=Math.floor(oy),pz=Math.floor(oz);
 for(let i=0;i<max*20;i++){
  const x=ox+dx*i/20,y=oy+dy*i/20,z=oz+dz*i/20;
  const bx=Math.floor(x),by=Math.floor(y),bz=Math.floor(z);
  if(bx!==px||by!==py||bz!==pz){
   const b=getBlock(bx,by,bz);
   if(b!=="air"&&b!=="water"&&b!=="torch"){
    return {x:bx,y:by,z:bz,block:b,px,py,pz};
   }
   px=bx;py=by;pz=bz;
  }
 }
 return null;
}

function mine(dt){
 if(!mouse.down){mineTarget=null;mineProgress=0;return;}
 const r=raycast();
 if(!r){mineTarget=null;mineProgress=0;return;}
 const key=r.x+","+r.y+","+r.z;
 if(!mineTarget||mineTarget.key!==key){mineTarget={...r,key};mineProgress=0;}
 const b=BLOCK[r.block];
 const speed=miningSpeed(held(),r.block);
 mineProgress+=dt*speed/(b.hard||1);
 if(mineProgress>=1){
  breakBlock(r.x,r.y,r.z);
  mineTarget=null;mineProgress=0;
 }
}

function placeBlock(){
 const r=raycast();
 if(!r)return;
 const h=held();
 if(!h||!ITEMS[h.id]||!ITEMS[h.id].block)return;
 const b=ITEMS[h.id].block;
 if(getBlock(r.px,r.py,r.pz)!=="air")return;
 if(collides(r.px+.5,r.py,r.pz+.5,1.8,.3))return;
 setBlock(r.px,r.py,r.pz,b);
 consume(h.id,1);
}

function interact(){
 const r=raycast();
 if(!r)return;
 if(r.block==="bed"){
  sleep();
  return;
 }
 if(r.block==="crafting_table"){craftingOpen=true;return}
 if(r.block==="furnace"){furnaceOpen=true;return}
 if(r.block==="chest"){chestOpen=true;return}
 if(r.block==="door"){
  setBlock(r.x,r.y,r.z,"air");
  return;
 }
 placeBlock();
}

function sleep(){
 if(Math.sin((time/dayLength)*Math.PI*2-Math.PI/2)>-.05)return;
 const r=raycast();
 if(!r||r.block!=="bed")return;
 player.spawn={x:r.x+.5,y:r.y+1,z:r.z+.5};
 sleeping=true;
 setTimeout(()=>{
  time=dayLength*.25;
  player.x=player.spawn.x;player.y=player.spawn.y;player.z=player.spawn.z;
  sleeping=false;
 },800);
}

const keys={};
addEventListener("keydown",e=>{
 const k=e.key.toLowerCase();
 keys[k]=true;
 if(k>="1"&&k<="9")selected=+k-1;
 if(k==="e")inventoryOpen=!inventoryOpen;
 if(k==="escape"){paused=!paused;inventoryOpen=craftingOpen=furnaceOpen=chestOpen=false}
 if(k==="q"&&held()){give(held().id,1);held().count--;if(held().count<=0)inv[selected]=null}
});
addEventListener("keyup",e=>keys[e.key.toLowerCase()]=false);

const mouse={x:0,y:0,down:false};
canvas.addEventListener("mousemove",e=>{
 if(document.pointerLockElement===canvas){
  player.yaw-=e.movementX*.0025;
  player.pitch-=e.movementY*.0025;
  player.pitch=Math.max(-1.45,Math.min(1.45,player.pitch));
 }
 mouse.x=e.clientX;mouse.y=e.clientY;
});
canvas.addEventListener("mousedown",e=>{
 if(e.button===0)mouse.down=true;
 if(e.button===2)placeBlock();
 if(document.pointerLockElement!==canvas)canvas.requestPointerLock();
});
addEventListener("mouseup",e=>{if(e.button===0)mouse.down=false});
canvas.addEventListener("contextmenu",e=>e.preventDefault());

function colorFor(b){
 return {
  grass:"#62b34c",dirt:"#8b5a2b",stone:"#777",cobblestone:"#666",
  oak_log:"#704523",oak_leaves:"#3b8f3c",oak_planks:"#a87945",
  sand:"#e0c878",sandstone:"#c8ad69",gravel:"#888",clay:"#b98777",
  snow:"#f2f2f2",ice:"#9dd7e8",packed_ice:"#8cc7d8",water:"#3c82d1",
  lava:"#e64a20",coal_ore:"#454545",iron_ore:"#b6a08b",gold_ore:"#d8bd35",
  diamond_ore:"#40d6df",redstone_ore:"#a33",obsidian:"#221d39",
  glass:"#b9e7f2",glowstone:"#f0d16c",bedrock:"#292929",
  mossy_cobblestone:"#547054",crafting_table:"#8b5a2b",furnace:"#555",
  chest:"#a96b27",bookshelf:"#805027",bed:"#bd3737",door:"#a06b3c",
  fence:"#996638",fence_gate:"#996638",slab:"#a87945",stairs:"#a87945",
  ladder:"#b27d45",torch:"#e0a52c",iron_bars:"#777",netherrack:"#8e3c32",
  quartz_ore:"#ddd"
 }[b]||"#777";
}

function camera(){
 return {x:player.x,y:player.y+1.6,z:player.z};
}

function project(x,y,z){
 const c=camera();
 let dx=x-c.x,dy=y-c.y,dz=z-c.z;
 const sy=Math.sin(player.yaw),cy=Math.cos(player.yaw);
 const rx=dx*cy-dz*sy,rz=dx*sy+dz*cy;
 const sp=Math.sin(player.pitch),cp=Math.cos(player.pitch);
 const ry=dy*cp-rz*sp,rzz=dy*sp+rz*cp;
 if(rzz<=.05)return null;
 const f=Math.min(W,H)*.9;
 return {x:W/2+rx/rzz*f,y:H/2-ry/rzz*f,z:rzz};
}

function drawCube(x,y,z,b){
 const p=project(x+.5,y+.5,z+.5);
 if(!p)return;
 const s=Math.max(2,Math.min(80,TILE*260/p.z));
 ctx.fillStyle=colorFor(b);
 ctx.fillRect(p.x-s/2,p.y-s/2,s,s);
 ctx.strokeStyle="rgba(0,0,0,.18)";
 ctx.strokeRect(p.x-s/2,p.y-s/2,s,s);
}

function renderWorld(){
 ctx.fillStyle="#87ceeb";ctx.fillRect(0,0,W,H);
 const cx=Math.floor(player.x),cy=Math.floor(player.y),cz=Math.floor(player.z);
 const radius=15;
 const visible=[];
 for(let x=cx-radius;x<=cx+radius;x++)
 for(let z=cz-radius;z<=cz+radius;z++){
  for(let y=Math.max(0,cy-8);y<=Math.min(WORLD_H-1,cy+18);y++){
   const b=getBlock(x,y,z);
   if(b==="air")continue;
   const p=project(x+.5,y+.5,z+.5);
   if(p)visible.push({x,y,z,b,d:p.z});
  }
 }
 visible.sort((a,b)=>b.d-a.d);
 for(const v of visible)drawCube(v.x,v.y,v.z,v.b);

 for(const m of mobs)drawMob(m);
 drawPlayer();
}

function drawMob(m){
 const p=project(m.x,m.y+1,m.z);
 if(!p)return;
 const s=Math.max(6,Math.min(55,220/p.z));
 const colors={
  cow:"#6d4527",pig:"#e88998",sheep:"#e7e7dc",
  zombie:"#43804f",skeleton:"#ddd",creeper:"#329244",spider:"#333"
 };
 ctx.fillStyle=colors[m.type]||"#fff";
 ctx.fillRect(p.x-s*.35,p.y-s*.65,s*.7,s*1.3);
 ctx.fillStyle="#111";
 if(m.type!=="spider"){
  ctx.fillRect(p.x-s*.2,p.y-s*.62,s*.12,s*.12);
  ctx.fillRect(p.x+s*.08,p.y-s*.62,s*.12,s*.12);
 }
 if(m.hp<m.maxHp){
  ctx.fillStyle="#222";ctx.fillRect(p.x-s/2,p.y-s*.82,s,s*.08);
  ctx.fillStyle="#e33";ctx.fillRect(p.x-s/2,p.y-s*.82,s*(m.hp/m.maxHp),s*.08);
 }
}

function drawPlayer(){
 const p=project(player.x,player.y+1,player.z);
 if(!p)return;
 const s=Math.max(8,Math.min(60,220/p.z));
 ctx.fillStyle="#4c83c3";ctx.fillRect(p.x-s*.35,p.y-s*.35,s*.7,s);
 ctx.fillStyle="#d8a77a";ctx.fillRect(p.x-s*.32,p.y-s*.72,s*.64,s*.4);
}

function drawHUD(){
 ctx.fillStyle="rgba(0,0,0,.45)";
 ctx.fillRect(12,H-86,280,74);
 ctx.fillStyle="#fff";ctx.font="14px monospace";
 ctx.fillText("HP "+player.hp+"/"+player.maxHp,22,H-62);
 ctx.fillText("Biome: "+biomeAt(Math.floor(player.x),Math.floor(player.z)),22,H-43);
 ctx.fillText("WASD move • Space jump • LMB mine",22,H-24);

 for(let i=0;i<9;i++){
  const x=W/2-4.5*48+i*48;
  ctx.fillStyle=i===selected?"#fff":"#555";
  ctx.fillRect(x,H-58,44,44);
  ctx.fillStyle="#222";ctx.fillRect(x+2,H-56,40,40);
  const s=inv[i];
  if(s){
   ctx.fillStyle=colorFor(ITEMS[s.id]?.block||"stone");
   ctx.fillRect(x+10,H-48,24,24);
   ctx.fillStyle="#fff";ctx.font="12px monospace";
   ctx.fillText(s.count,x+28,H-22);
  }
 }
}

function drawCrosshair(){
 ctx.strokeStyle="#fff";ctx.lineWidth=2;
 ctx.beginPath();ctx.moveTo(W/2-7,H/2);ctx.lineTo(W/2+7,H/2);
 ctx.moveTo(W/2,H/2-7);ctx.lineTo(W/2,H/2+7);ctx.stroke();
}

function drawMenu(title,lines){
 ctx.fillStyle="rgba(0,0,0,.72)";ctx.fillRect(0,0,W,H);
 ctx.fillStyle="#fff";ctx.textAlign="center";
 ctx.font="bold 32px monospace";ctx.fillText(title,W/2,H/2-120);
 ctx.font="16px monospace";
 lines.forEach((s,i)=>ctx.fillText(s,W/2,H/2-70+i*28));
 ctx.textAlign="left";
}

function render(){
 renderWorld();
 drawHUD();
 drawCrosshair();
 if(paused)drawMenu("PAUSED",["ESC — resume","E — inventory","WASD — move"]);
 if(inventoryOpen)drawMenu("INVENTORY",inventoryText());
 if(craftingOpen)drawMenu("CRAFTING",recipeText());
 if(furnaceOpen)drawMenu("FURNACE",["Furnace interface","Coming from the active furnace system"]);
 if(chestOpen)drawMenu("CHEST",["Chest inventory"]);
 if(sleeping)drawMenu("Sleeping",["The night is passing..."]);
}

function inventoryText(){
 const out=[];
 for(let i=0;i<inv.length;i++){
  if(inv[i])out.push((i+1)+": "+ITEMS[inv[i].id].name+" x"+inv[i].count);
 }
 return out.length?out:["Empty"];
}

function recipeText(){
 return RECIPES.map((r,i)=>i+": "+ITEMS[r.out].name+" x"+r.n);
}

let last=performance.now();
let saveTimer=0;

function loop(now){
 const dt=Math.min(.05,(now-last)/1000);last=now;
 update(dt);
 render();
 requestAnimationFrame(loop);
}

function saveGame(){
 const data={
  player:{x:player.x,y:player.y,z:player.z,yaw:player.yaw,pitch:player.pitch,hp:player.hp,spawn:player.spawn},
  inv,time,
  chunks:[...chunks].map(([k,c])=>[k,Array.from(c.b)]),
  mobs:mobs.map(m=>({type:m.type,x:m.x,y:m.y,z:m.z,hp:m.hp}))
 };
 try{localStorage.setItem(SAVEKEY,JSON.stringify(data));}catch(e){}
}

function loadGame(){
 try{
  const s=JSON.parse(localStorage.getItem(SAVEKEY)||"null");
  if(!s)return;
  Object.assign(player,s.player||{});
  if(s.player?.spawn)player.spawn=s.player.spawn;
  for(let i=0;i<36;i++)inv[i]=s.inv?.[i]||null;
  time=s.time||0;
  if(s.chunks){
   for(const [k,a] of s.chunks){
    const [cx,cz]=k.split(",").map(Number);
    const c={cx,cz,b:new Uint8Array(a),generated:true};
    chunks.set(k,c);
   }
  }
  mobs.length=0;
  for(const m of s.mobs||[])spawnMob(m.type,m.x,m.y,m.z);
 }catch(e){}
}

loadGame();
if(!localStorage.getItem(SAVEKEY)){
 generateChunk(getChunk(0,0));
 player.y=terrainHeight(0,0)+2;
 player.spawn={x:player.x,y:player.y,z:player.z};
 give("oak_planks",16);
 give("stick",8);
 give("wooden_pickaxe",1);
}

for(let i=0;i<8;i++){
 const x=(Math.random()-.5)*40,z=(Math.random()-.5)*40;
 spawnMob(Math.random()<.5?"cow":"pig",x,terrainHeight(x,z)+1,z);
}

requestAnimationFrame(loop);
</script>
</body>

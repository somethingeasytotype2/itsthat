function give(item,n=1){
 for(let i=0;i<inv.length&&n>0;i++){
  if(inv[i]&&inv[i].id===item&&inv[i].count<64){
   const q=Math.min(64-inv[i].count,n);inv[i].count+=q;n-=q;
  }
 }
 for(let i=0;i<inv.length&&n>0;i++){
  if(!inv[i]){const q=Math.min(64,n);inv[i]={id:item,count:q};n-=q;}
 }
}
function countItem(id){
 return inv.reduce((a,s)=>a+(s&&s.id===id?s.count:0),0);
}
function consume(id,n){
 for(let i=0;i<inv.length&&n>0;i++){
  if(inv[i]&&inv[i].id===id){
   const q=Math.min(n,inv[i].count);inv[i].count-=q;n-=q;
   if(inv[i].count<=0)inv[i]=null;
  }
 }
 return n===0;
}
function held(){return inv[selected]}

function toolInfo(item){
 if(!item)return null;
 const d=ITEMS[item.id];
 return d&&d.tool?d:null;
}

function miningSpeed(item,b){
 const d=BLOCK[b]||BLOCK.air;
 if(!d.hard)return 1;
 const t=toolInfo(item);
 if(!t)return d.tool?.length?0.15:0.45;
 if(d.tool===t.tool){
  const tier=t.tier||0;
  if(d.tier!=null&&tier<d.tier)return .25;
  return t.power||2;
 }
 return d.tool?.length?0.18:1;
}

function canDropNormally(item,b){
 const d=BLOCK[b];
 if(!d.requiresToolDrop)return true;
 const t=toolInfo(item);
 return !!t&&t.tool===d.tool&&(t.tier||0)>=(d.tier||0);
}

function breakBlock(x,y,z){
 const b=getBlock(x,y,z);
 if(b==="air"||b==="bedrock")return;
 const d=BLOCK[b];
 setBlock(x,y,z,"air");
 let drop=d.drop||b;
 if(d.requiresToolDrop&&!canDropNormally(held(),b))drop=null;
 if(drop&&ITEMS[drop])give(drop,1);
 if(b==="oak_leaves"&&Math.random()<.05)give("oak_sapling",1);
 if(b==="oak_leaves"&&Math.random()<.08)give("stick",1);
}

function solidAt(x,y,z){
 return BLOCK[getBlock(x,y,z)]?.solid===true;
}

function collides(x,y,z,h=1.8,r=.3){
 const minX=Math.floor(x-r),maxX=Math.floor(x+r);
 const minY=Math.floor(y),maxY=Math.floor(y+h);
 const minZ=Math.floor(z-r),maxZ=Math.floor(z+r);
 for(let xx=minX;xx<=maxX;xx++)
 for(let yy=minY;yy<=maxY;yy++)
 for(let zz=minZ;zz<=maxZ;zz++)
  if(solidAt(xx,yy,zz))return true;
 return false;
}

function moveEntity(e,dx,dy,dz,h=1.8,r=.3){
 let nx=e.x+dx,ny=e.y+dy,nz=e.z+dz;
 if(!collides(nx,e.y,nz,h,r)){e.x=nx;e.z=nz;}
 else{
  if(!collides(nx,e.y+.95,nz,h,r)){e.x=nx;e.y+=.95;}
 }
 if(!collides(e.x,ny,e.z,h,r)){e.y=ny;e.onGround=false;}
 else{
  if(dy<0)e.onGround=true;
  e.vy=0;
 }
}

function nodeKey(x,y,z){return x+","+y+","+z}
function walkable(x,y,z){
 if(x<-100000||x>100000)return false;
 return !solidAt(x,y,z)&&!solidAt(x,y+1,z)&&solidAt(x,y-1,z);
}
function neighbors(n){
 const out=[];
 const dirs=[[1,0],[-1,0],[0,1],[0,-1]];
 for(const [dx,dz] of dirs){
  for(let dy=-1;dy<=1;dy++){
   const x=n.x+dx,y=n.y+dy,z=n.z+dz;
   if(walkable(x,y,z)){out.push({x,y,z});break;}
  }
 }
 return out;
}

function heuristic(a,b){
 return Math.abs(a.x-b.x)+Math.abs(a.y-b.y)+Math.abs(a.z-b.z);
}

function findPath(s,g,maxNodes=600){
 s={x:Math.floor(s.x),y:Math.floor(s.y),z:Math.floor(s.z)};
 g={x:Math.floor(g.x),y:Math.floor(g.y),z:Math.floor(g.z)};
 if(!walkable(g.x,g.y,g.z)){
  for(let r=1;r<4;r++){
   let found=null;
   for(let dx=-r;dx<=r;dx++)for(let dz=-r;dz<=r;dz++){
    const yy=g.y;
    if(walkable(g.x+dx,yy,g.z+dz)){found={x:g.x+dx,y:yy,z:g.z+dz};break;}
   }
   if(found){g=found;break;}
  }
 }
 const open=[s],came=new Map(),gScore=new Map([[nodeKey(s.x,s.y,s.z),0]]);
 const fScore=new Map([[nodeKey(s.x,s.y,s.z),heuristic(s,g)]]);
 const closed=new Set();
 let nodes=0;
 while(open.length&&nodes++<maxNodes){
  open.sort((a,b)=>(fScore.get(nodeKey(a.x,a.y,a.z))||1e9)-(fScore.get(nodeKey(b.x,b.y,b.z))||1e9));
  const cur=open.shift(),ck=nodeKey(cur.x,cur.y,cur.z);
  if(ck===nodeKey(g.x,g.y,g.z)){
   const path=[cur];
   let k=ck;
   while(came.has(k)){const p=came.get(k);path.push(p);k=nodeKey(p.x,p.y,p.z)}
   return path.reverse();
  }
  closed.add(ck);
  for(const n of neighbors(cur)){
   const nk=nodeKey(n.x,n.y,n.z);
   if(closed.has(nk))continue;
   const ng=(gScore.get(ck)||0)+1+Math.abs(n.y-cur.y)*.25;
   if(!gScore.has(nk)||ng<gScore.get(nk)){
    came.set(nk,cur);gScore.set(nk,ng);
    fScore.set(nk,ng+heuristic(n,g));
    if(!open.some(q=>nodeKey(q.x,q.y,q.z)===nk))open.push(n);
   }
  }
 }
 return [];
}


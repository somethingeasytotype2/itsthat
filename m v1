function hash(x,z){
 let n=Math.sin(x*127.1+z*311.7)*43758.5453;
 return n-Math.floor(n);
}
function noise(x,z){
 const x0=Math.floor(x),z0=Math.floor(z);
 const xf=x-x0,zf=z-z0;
 const a=hash(x0,z0),b=hash(x0+1,z0),c=hash(x0,z0+1),d=hash(x0+1,z0+1);
 const u=xf*xf*(3-2*xf),v=zf*zf*(3-2*zf);
 return a+(b-a)*u+((c+(d-c)*u)-(a+(b-a)*u))*v;
}
function fbm(x,z){
 let v=0,a=.5,f=.02;
 for(let i=0;i<5;i++){v+=noise(x*f,z*f)*a;f*=2;a*=.5}
 return v;
}
function biomeAt(x,z){
 const t=fbm(x+900,z+900);
 const h=fbm(x-500,z-500);
 if(t<.25)return "snow";
 if(t>.78&&h<.42)return "desert";
 if(h>.72)return "forest";
 return "plains";
}

const chunks=new Map();
function key(cx,cz){return cx+","+cz}
function getChunk(cx,cz){
 const k=key(cx,cz);
 if(chunks.has(k))return chunks.get(k);
 const c={cx,cz,b:new Uint8Array(CHUNK*WORLD_H*CHUNK),generated:true};
 generateChunk(c);
 chunks.set(k,c);
 return c;
}
function idx(x,y,z){return x+CHUNK*(z+CHUNK*y)}
const blockList=Object.keys(BLOCK);
const blockId={};
blockList.forEach((n,i)=>blockId[n]=i);

function setLocal(c,x,y,z,b){
 if(x>=0&&x<CHUNK&&z>=0&&z<CHUNK&&y>=0&&y<WORLD_H)c.b[idx(x,y,z)]=blockId[b];
}
function getLocal(c,x,y,z){
 if(x<0||x>=CHUNK||z<0||z>=CHUNK||y<0||y>=WORLD_H)return "air";
 return blockList[c.b[idx(x,y,z)]]||"air";
}

function terrainHeight(x,z){
 const biome=biomeAt(x,z);
 let h=43+Math.floor(fbm(x,z)*18);
 if(biome==="desert")h+=2;
 if(biome==="snow")h+=2;
 return Math.max(3,Math.min(WORLD_H-8,h));
}

function generateTree(c,x,y,z){
 for(let i=0;i<5;i++)setLocal(c,x,y+i,z,"oak_log");
 for(let dx=-2;dx<=2;dx++)
 for(let dz=-2;dz<=2;dz++)
 for(let dy=3;dy<=5;dy++){
  if(Math.abs(dx)+Math.abs(dz)<4+(dy===3?1:0))
   setLocal(c,x+dx,y+dy,z+dz,"oak_leaves");
 }
}

function generateChunk(c){
 for(let lx=0;lx<CHUNK;lx++){
  for(let lz=0;lz<CHUNK;lz++){
   const x=c.cx*CHUNK+lx,z=c.cz*CHUNK+lz;
   const biome=biomeAt(x,z);
   const h=terrainHeight(x,z);
   for(let y=0;y<=h;y++){
    let b="stone";
    if(y===0)b="bedrock";
    else if(y>h-4)b=biome==="desert"?"sand":biome==="snow"?"snow":"dirt";
    if(y===h)b=biome==="desert"?"sand":biome==="snow"?"snow":"grass";
    setLocal(c,lx,y,lz,b);
   }
   if(h<SEA){
    for(let y=h+1;y<=SEA;y++)setLocal(c,lx,y,lz,"water");
   }
   for(let y=4;y<h-4;y++){
    const r=hash(x*3+y,z*7-y);
    let ore=null;
    if(y<14&&r>.987)ore="diamond_ore";
    else if(y<20&&r>.976)ore="gold_ore";
    else if(y<32&&r>.965)ore="iron_ore";
    else if(r>.94)ore="coal_ore";
    if(ore)setLocal(c,lx,y,lz,ore);
   }
   if(biome==="desert"&&hash(x,z)>.96){
    for(let q=0;q<3;q++)setLocal(c,lx,h+1+q,lz,"cactus");
   }
   if((biome==="forest"||biome==="plains")&&h>=SEA&&hash(x,z)>.88){
    if(lx>2&&lx<CHUNK-3&&lz>2&&lz<CHUNK-3)generateTree(c,lx,h+1,lz);
   }
  }
 }
}

function getBlock(x,y,z){
 x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);
 if(y<0||y>=WORLD_H)return y<0?"bedrock":"air";
 const cx=Math.floor(x/CHUNK),cz=Math.floor(z/CHUNK);
 const lx=((x%CHUNK)+CHUNK)%CHUNK,lz=((z%CHUNK)+CHUNK)%CHUNK;
 return getLocal(getChunk(cx,cz),lx,y,lz);
}
function setBlock(x,y,z,b){
 x=Math.floor(x);y=Math.floor(y);z=Math.floor(z);
 if(y<0||y>=WORLD_H)return;
 const cx=Math.floor(x/CHUNK),cz=Math.floor(z/CHUNK);
 const lx=((x%CHUNK)+CHUNK)%CHUNK,lz=((z%CHUNK)+CHUNK)%CHUNK;
 setLocal(getChunk(cx,cz),lx,y,lz,b);
}

